            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Etat" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "custom.align", "value": "center" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Hostname" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Voir le détail",
                    "url": "/d/server-detail-dash/detail-serveur?var-server=${__data.fields.Instance}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Instance" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          }
        ]
      },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Etat" }]
      },
      "pluginVersion": "12.3.11",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "max by(instance) (\n  100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)\nor\n  100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))\nor\n  (time() - node_boot_time_seconds < 300) * 100\n)",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "node_uname_info",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "(time() - node_boot_time_seconds) / 3600",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "count by(instance) (node_cpu_seconds_total{mode=\"idle\"})",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "Etat des serveurs",
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "instance", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "job": true,
              "domainname": true,
              "release": true,
              "machine": true
            },
            "indexByName": {},
            "renameByName": {
              "instance": "Instance",
              "Value #A": "Etat",
              "sysname": "OS",
              "nodename": "Hostname",
              "Value #C": "Uptime (h)",
              "Value #D": "Nb CPU"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
