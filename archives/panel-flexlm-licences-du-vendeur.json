{
  "id": 1,
  "type": "table",
  "title": "Licences du vendeur",
  "gridPos": {
    "x": 0,
    "y": 0,
    "h": 10,
    "w": 24
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "align": "auto",
        "footer": {
          "reducers": []
        },
        "cellOptions": {
          "type": "auto"
        },
        "inspect": false,
        "filterable": true
      },
      "mappings": [],
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "color": "green",
            "value": null
          }
        ]
      },
      "color": {
        "mode": "thresholds"
      },
      "unit": "d"
    },
    "overrides": [
      {
        "matcher": {
          "id": "byName",
          "options": "Total"
        },
        "properties": [
          {
            "id": "unit",
            "value": "short"
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "Utilisees"
        },
        "properties": [
          {
            "id": "unit",
            "value": "short"
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "Expiration"
        },
        "properties": [
          {
            "id": "custom.cellOptions",
            "value": {
              "type": "color-background"
            }
          },
          {
            "id": "custom.align",
            "value": "center"
          },
          {
            "id": "unit",
            "value": "dateTimeAsSystem"
          },
          {
            "id": "mappings",
            "value": [
              {
                "options": {
                  "match": "null",
                  "result": {
                    "text": "Pas d'expiration"
                  }
                },
                "type": "special"
              },
              {
                "options": {
                  "match": "empty",
                  "result": {
                    "text": "Pas d'expiration"
                  }
                },
                "type": "special"
              }
            ]
          }
        ]
      }
    ]
  },
  "transformations": [
    {
      "id": "convertFieldType",
      "options": {
        "conversions": [
          {
            "destinationType": "string",
            "targetField": "name"
          }
        ]
      }
    },
    {
      "id": "joinByField",
      "options": {
        "byField": "name",
        "mode": "outer"
      }
    },
    {
      "id": "organize",
      "options": {
        "excludeByName": {
          "Time": true,
          "Time 1": true,
          "Time 2": true,
          "__name__": true,
          "app": true,
          "app 1": true,
          "app 2": true,
          "index": true,
          "instance": true,
          "instance 1": true,
          "instance 2": true,
          "job": true,
          "job 1": true,
          "job 2": true,
          "licenses": true,
          "vendor": true,
          "version": true
        },
        "indexByName": {
          "Value #A": 2,
          "Value #B": 3,
          "Value #C": 4,
          "app": 0,
          "name": 1
        },
        "renameByName": {
          "Value #A": "Total",
          "Value #B": "Utilisees",
          "Value #C": "Expiration_raw",
          "app": "Vendeur",
          "name": "Licence"
        }
      }
    },
    {
      "id": "convertFieldType",
      "options": {
        "conversions": [
          {
            "destinationType": "time",
            "targetField": "Expiration_raw"
          }
        ]
      }
    },
    {
      "id": "organize",
      "options": {
        "excludeByName": {},
        "indexByName": {},
        "renameByName": {
          "Expiration_raw": "Expiration"
        }
      }
    },
    {
      "id": "filterByValue",
      "options": {
        "filters": [
          {
            "config": {
              "id": "greater",
              "options": {
                "value": 0
              }
            },
            "fieldName": "Total"
          }
        ],
        "match": "all",
        "type": "include"
      }
    }
  ],
  "pluginVersion": "12.3.11",
  "targets": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "expr": "flexlm_feature_issued{app=\"$vendor\"}",
      "format": "table",
      "instant": true,
      "legendFormat": "",
      "refId": "A"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "expr": "flexlm_feature_used{app=\"$vendor\"}",
      "format": "table",
      "instant": true,
      "legendFormat": "",
      "refId": "B"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "expr": "flexlm_feature_expiration_seconds{app=\"$vendor\"} * 1000",
      "format": "table",
      "instant": true,
      "legendFormat": "",
      "refId": "C"
    }
  ],
  "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
  },
  "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "enablePagination": false,
    "sortBy": []
  }
}
