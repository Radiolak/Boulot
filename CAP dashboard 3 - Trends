          "editorMode": "code",
          "expr": "avg(avg_over_time((100 * (1 - sum by(host) (rate(node_cpu_seconds_total{job=\"node_exporter\", host=~\"$server\", mode=\"idle\"}[5m])) / count by(host) (node_cpu_seconds_total{job=\"node_exporter\", host=~\"$server\", mode=\"idle\"})))[$__range:30m]))",
