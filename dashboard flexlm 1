          "options": {
            "alias": "Usage %",
            "mode": "binary",
            "binary": {
              "left": "Value #B",
              "operator": "/",
              "right": "Value #A"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Usage %",
            "mode": "binary",
            "binary": {
              "left": "Usage %",
              "operator": "*",
              "right": "100"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "app 1": true, "__name__": true },
