# Extraction (détecte automatiquement le nom du tar.gz présent dans ~)
cd ~
tar -xzf node_exporter-*.linux-amd64.tar.gz

# Création de l'utilisateur dédié (ignore l'erreur si déjà existant)
sudo useradd -d /usr/share/node_exporter -s /bin/false node_exporter 2>/dev/null

# Déploiement du binaire
sudo mkdir -p /usr/share/node_exporter
sudo mv node_exporter-*.linux-amd64/node_exporter /usr/share/node_exporter/
sudo chown -R node_exporter:node_exporter /usr/share/node_exporter
sudo chmod 755 /usr/share/node_exporter/node_exporter

# Création du service systemd
sudo tee /etc/systemd/system/node_exporter.service > /dev/null <<'EOF'
[Unit]
Description=Node Exporter
After=network.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/usr/share/node_exporter/node_exporter
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

# Activation et démarrage
sudo systemctl daemon-reload
sudo systemctl enable --now node_exporter

# Ouverture du firewall
sudo firewall-cmd --permanent --add-port=9100/tcp
sudo firewall-cmd --reload

# Vérification finale
systemctl status node_exporter --no-pager
curl -s http://localhost:9100/metrics | head -5
