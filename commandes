#!/softs/ActivePerl-5.14_64bits/bin/perl

use strict;
use warnings;
use diagnostics;

use Date::Manip;

# Script créé par Christophe Le Lann le 07/05/2024

# Affiche un message dans le MOTD pour prévenir de l'occurrence du prochain reboot planifié

# Ce script est censé être appelé toutes les heures pour régénérer un fichier MOTD (ou équivalent), lequel est affiché à l'utilisateur quand il se connecte en SSH sur la machine
# La planification peut se faire via tâche CRON, ou via un timer systemd
#
# Dans la ligne d'appel, on peut spécifier le timing du reboot, sous cette forme :
# "reboot_motd_generate.pl Wednesday 3rd 6 > /etc/motd" => le 3e mercredi du mois à 6h du matin
# Si on ne spécifie rien, les valeurs par défaut sont le 3e samedi du mois à 6h du matin

# Le calcul de date est défini selon un pattern du type "3e mardi du mois", où l'on peut configurer le jour (mardi) et le numéro (3e) ci-dessous
# Pour avoir un même script sur tous les serveurs malgré des dates différentes, il est possible de sourcer ces paramètres depuis la ligne de commande ($ARGV[0], $ARGV[1], etc)
my $weekday              = $ARGV[0] || "Saturday";
my $Nth_weekday_of_month = $ARGV[1] || "3rd";
my $hour                 = $ARGV[2] || 6;

my $now = ParseDate("now");
my $this_month = UnixDate($now, "%B %Y");
my $next_month = UnixDate(ParseDate("next month"), "%B %Y");

my $this_month_reboot = ParseDate("$Nth_weekday_of_month $weekday in $this_month at $hour:00")."\n";
my $next_month_reboot = ParseDate("$Nth_weekday_of_month $weekday in $next_month at $hour:00")."\n";

my $next_reboot = (Date_Cmp($now, $this_month_reboot) < 0) ? $this_month_reboot : $next_month_reboot;
my $next_reboot_as_str = UnixDate($next_reboot, "%d/%m/%Y %H:%M");

my $delta = DateCalc($now, $next_reboot)."\n";
my $delta_in_days  = Delta_Format($delta, "%dys") + 0;
my $delta_in_hours = Delta_Format($delta, "%hys") + 0;

# On affiche vert si le reboot est lointain, orange s'il est proche, rouge s'il est très proche
my $color = ($delta_in_days > 5) ? "\e[0;42m\e[1;37m" : ($delta_in_days > 1.5) ? "\e[0;43m\e[1;37m" : "\e[0;41m\e[1;37m";
my $color_default = "\e[0m";

print "+----------------------------------------------------------+\n";
print "| Merci de composer le 68-00 pour toute demande de support |\n";
print "|            et intervention sur cette machine.            |\n";
print "+----------------------------------------------------------+\n";
printf "| $color        Reboot scheduled in %2d days and %2d hours        $color_default |\n", int($delta_in_days), int($delta_in_hours)-24*int($delta_in_days);
print "| $color                   ($next_reboot_as_str)                   $color_default |\n";
print "+----------------------------------------------------------+\n";

