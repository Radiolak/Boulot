- job_name: 'process_exporter'
  scrape_interval: 30s
  static_configs:
    - targets:
      - 'coxa.fr.airbusds.corp:9256'
      # ... tes autres machines
  metric_relabel_configs:
    - source_labels: [__name__]
      regex: 'namedprocess_namegroup_(cpu_seconds_total|memory_bytes|num_procs|oldest_start_time_seconds)|namedprocess_scrape_(errors|partial_errors|procread_errors)'
      action: keep


sudo promtool check config /etc/prometheus/prometheus.yml
sudo systemctl reload prometheus
