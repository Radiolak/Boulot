# Arrête le service
sudo systemctl stop grafana-server

# Supprime complètement les anciens public/ et bin/ (l'ancienne version 6.4.4)
sudo rm -rf /usr/share/grafana/public
sudo rm -rf /usr/share/grafana/bin
sudo rm -rf /usr/share/grafana/conf

# Recopie proprement depuis la nouvelle version extraite
sudo cp -r ~/grafana-13.2.0/public /usr/share/grafana/
sudo cp -r ~/grafana-13.2.0/bin /usr/share/grafana/
sudo cp -r ~/grafana-13.2.0/conf /usr/share/grafana/

# Refixe les droits et le lien /usr/sbin/grafana-server
sudo chown -R grafana:grafana /usr/share/grafana
sudo cp /usr/share/grafana/bin/grafana-server /usr/sbin/grafana-server
sudo chown grafana:grafana /usr/sbin/grafana-server
sudo chmod 755 /usr/sbin/grafana-server





ExecStart=/usr/share/grafana/bin/grafana server \
    --config=${CONF_FILE} \
    --pidfile=${PID_FILE_DIR}/grafana-server.pid \
    --homepath=/usr/share/grafana \
    cfg:default.paths.logs=${LOG_DIR} \
    cfg:default.paths.data=${DATA_DIR} \
    cfg:default.paths.plugins=${PLUGINS_DIR} \
    cfg:default.paths.provisioning=${PROVISIONING_CFG_DIR}

