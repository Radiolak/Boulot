          "editorMode": "code",
          "expr": "count((max by(app, name) (max_over_time(flexlm_feature_issued{app=~\"$vendor\"}[$__range])) > 0) unless on(app, name) ((max by(app, name) (max_over_time(flexlm_feature_used{app=~\"$vendor\"}[$__range]))) > 0)) or vector(0)",
