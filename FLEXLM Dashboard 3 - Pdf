    {
      "id": 11,
      "type": "table",
      "title": "All licences - usage over the period",
      "description": "Status: Saturated = all licences taken more than 5% of the time / Never used = no checkout in the period / Under-used = less than 20% on average / Healthy = the rest.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 23,
        "h": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "((100 * max by(app, name) (avg_over_time(((flexlm_feature_used{app=~\"$vendor\"} >= bool flexlm_feature_issued{app=~\"$vendor\"}) and on(app, name) (flexlm_feature_issued{app=~\"$vendor\"} > 0))[$__range:5m]))) > 5) * 0 + 3 or ((max by(app, name) (max_over_time(flexlm_feature_used{app=~\"$vendor\"}[$__range]))) == 0 and on(app, name) (max by(app, name) (max_over_time(flexlm_feature_issued{app=~\"$vendor\"}[$__range])) > 0)) * 0 + 0 or ((100 * (max by(app, name) (avg_over_time(flexlm_feature_used{app=~\"$vendor\"}[$__range]))) / (max by(app, name) (max_over_time(flexlm_feature_issued{app=~\"$vendor\"}[$__range])) > 0)) < 20) * 0 + 1 or (max by(app, name) (max_over_time(flexlm_feature_issued{app=~\"$vendor\"}[$__range])) > 0) * 0 + 2",
