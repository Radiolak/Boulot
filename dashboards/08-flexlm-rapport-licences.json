            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "((100 * max by(app, name) (avg_over_time(((flexlm_feature_used{app=~\"$vendor\"} >= bool flexlm_feature_issued{app=~\"$vendor\"}) and on(app, name) (flexlm_feature_issued{app=~\"$vendor\"} > 0))[$__range:15m]))) > 5) * 0 + 3 or ((max by(app, name) (max_over_time(max_over_time(flexlm_feature_used{app=~\"$vendor\"}[1d])[$__range:1d]))) == 0 and on(app, name) ((max by(app, name) (max_over_time(flexlm_feature_issued{app=~\"$vendor\"}[$__range:6h])) > 0) < 100000)) * 0 + 0 or ((100 * (max by(app, name) (avg_over_time(flexlm_feature_used{app=~\"$vendor\"}[$__range:5m]))) / ((max by(app, name) (max_over_time(flexlm_feature_issued{app=~\"$vendor\"}[$__range:6h])) > 0) < 100000)) < 20) * 0 + 1 or ((max by(app, name) (max_over_time(flexlm_feature_issued{app=~\"$vendor\"}[$__range:6h])) > 0) < 100000) * 0 + 2",
          "refId": "A",
